rules_version = '2';

// ─────────────────────────────────────────────────────────────
// REGLAS DE SEGURIDAD — datos clínicos de una persona real.
//
// Principio: nadie lee ni escribe nada sin estar autenticado Y
// figurar en la lista de correos autorizados de abajo.
//
// Para dar acceso a otro familiar, agrega su correo a la lista
// y vuelve a publicar las reglas:
//     firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
               'hahiguit@gmail.com'
               // , 'otro.familiar@gmail.com'
             ];
    }

    // Validación de forma de un hemograma
    function hemogramaValido(d) {
      return d.keys().hasAll(['fecha'])
          && d.fecha is string
          && (!('hb' in d)          || d.hb == null          || (d.hb is number          && d.hb >= 0 && d.hb <= 30))
          && (!('hto' in d)         || d.hto == null         || (d.hto is number         && d.hto >= 0 && d.hto <= 100))
          && (!('leucocitos' in d)  || d.leucocitos == null  || (d.leucocitos is number  && d.leucocitos >= 0 && d.leucocitos <= 500))
          && (!('neutrofilos' in d) || d.neutrofilos == null || (d.neutrofilos is number && d.neutrofilos >= 0 && d.neutrofilos <= 500))
          && (!('plaquetas' in d)   || d.plaquetas == null   || (d.plaquetas is number   && d.plaquetas >= 0 && d.plaquetas <= 2000));
    }

    function signoValido(d) {
      return d.keys().hasAll(['fecha'])
          && d.fecha is string
          && (!('temp' in d) || d.temp == null || (d.temp is number && d.temp >= 30 && d.temp <= 45))
          && (!('spo2' in d) || d.spo2 == null || (d.spo2 is number && d.spo2 >= 0  && d.spo2 <= 100))
          && (!('peso' in d) || d.peso == null || (d.peso is number && d.peso >= 0  && d.peso <= 300))
          && (!('sis' in d)  || d.sis  == null || (d.sis  is number && d.sis  >= 0  && d.sis  <= 300))
          && (!('dia' in d)  || d.dia  == null || (d.dia  is number && d.dia  >= 0  && d.dia  <= 200))
          && (!('fc' in d)   || d.fc   == null || (d.fc   is number && d.fc   >= 0  && d.fc   <= 300));
    }

    match /pacientes/{pacienteId} {
      allow read, write: if autorizado();

      match /hemogramas/{docId} {
        allow read, delete: if autorizado();
        allow create, update: if autorizado() && hemogramaValido(request.resource.data);
      }

      match /signos/{docId} {
        allow read, delete: if autorizado();
        allow create, update: if autorizado() && signoValido(request.resource.data);
      }

      match /aplicaciones/{docId} {
        allow read, write: if autorizado();
      }
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
