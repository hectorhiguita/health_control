# Copia este archivo a .env y pega los valores de tu proyecto Firebase.
# Consola Firebase > Configuración del proyecto > Tus apps > Configuración del SDK
#
# Estos valores NO son secretos: identifican tu proyecto, no dan acceso.
# La seguridad real está en firestore.rules y en la autenticación.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correos autorizados a entrar, separados por coma.
# Cualquier otro correo queda bloqueado aunque logre autenticarse.
VITE_CORREOS_AUTORIZADOS=hahiguit@gmail.com
